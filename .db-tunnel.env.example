# 複製為 .db-tunnel.env 後填入實際值；本機設定不提交到 Git。
TUNNEL_SSH_TARGET='your_user@your_server'

# 以下可省略，腳本會使用這些預設值。
# TUNNEL_SSH_PORT=22
# TUNNEL_LOCAL_PORT=15432
# TUNNEL_DB_HOST='127.0.0.1'
# TUNNEL_DB_PORT=5432

# 預設使用 SSH agent／OpenSSH 的既有設定；需要指定私鑰時再取消註解。
# TUNNEL_IDENTITY_FILE="$HOME/.ssh/id_ed25519"

# 預設為 /tmp/mall-db-tunnel-<UID>-<本機 port>。
# 變更連線設定前先 stop；執行中不要更換狀態目錄。
# TUNNEL_STATE_DIR='/tmp/my-mall-db-tunnel'
